# Database
DATABASE_URL="postgresql://user:password@localhost:5432/edmeca_db?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Email (Resend or SendGrid)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="your-api-key"
EMAIL_FROM="noreply@edmeca.com"

# File Storage (S3-compatible)
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="edmeca-files"
S3_REGION="auto"
S3_ENDPOINT="https://your-bucket.r2.cloudflarestorage.com"
